# Terraform state files - contain sensitive data (passwords, keys)
terraform.tfstate
terraform.tfstate.backup
terraform.tfstate.d/

# Terraform working directory
.terraform/

# Terraform variable files with sensitive values
terraform.tfvars
*.tfvars
*.tfvars.json

# Generated SSH private keys
*.pem

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*.tfplan

# Environment variable files
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Extra markdown docs (keep README.md)
GITHUB_POST.md
NOTION_NOTES.md
PROMPT.md
